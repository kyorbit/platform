{
  "name": "kyorbit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A modern, user-friendly web application for managing Taekwondo sparring matches.",
  "homepage": "https://kyorbit.vercel.app",
  "license": "MIT",
  "author": {
    "name": "Le Tran Gia Bao",
    "email": "letrangiabao14@gmail.com",
    "url": "https://github.com/chef0111"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyorbit/platform.git"
  },
  "scripts": {
    "dev": "portless kyorbit vite dev --port 3000",
    "preview": "portless kyorbit vite preview",
    "build": "bun run db:generate && vite build",
    "start": "bun run build && portless kyorbit vite preview",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "routes:generate": "tsr generate",
    "test": "vitest run",
    "typecheck": "node ./node_modules/typescript-7/bin/tsc --skipLibCheck --extendedDiagnostics",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:fix": "eslint --fix . --cache --cache-location .eslintcache",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,md,mdx}\" --cache",
    "upgrade:auth": "npx auth upgrade",
    "upgrade:tailwind": "npx @tailwindcss/upgrade@latest",
    "skills:add": "npx skills@latest add",
    "intent": "npx @tanstack/intent@latest install",
    "intent:ls": "npx @tanstack/intent@latest list",
    "intent:load": "npx @tanstack/intent@latest load",
    "prepare": "husky"
  },
